# ── Backend ───────────────────────────────────────────────────────────────────
# The Express API. Server-only (deliberately NOT NEXT_PUBLIC): every call goes
# through a Server Component or an app/api/** route handler, so the browser
# never learns this URL and never talks to the backend directly.
BACKEND_API_URL=http://localhost:8000

# ── Clerk (the CUSTOMER application) ──────────────────────────────────────────
# A SEPARATE Clerk application from the vendor and admin ones. The backend's
# verifyCustomerToken asserts the token's issuer is the customer instance, so a
# valid vendor token cannot authenticate here.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZGVzaXJlZC1veC0zNzExLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_7NprG8G47PJFZHEIlZwrB7SOPLW6MCNXESEL7tzwVt

# Where Clerk sends people. Kept in env rather than hardcoded so the hosted
# pages and the in-app ones can be switched without a code change.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Images ────────────────────────────────────────────────────────────────────
# Menu photography is served as short-lived signed URLs from a PRIVATE R2
# bucket, so the host differs per environment. Comma-separated; the r2.dev and
# r2.cloudflarestorage.com wildcards are already allowed in next.config.js.
# NEXT_PUBLIC_IMAGE_HOSTS=media.dailybread.example
