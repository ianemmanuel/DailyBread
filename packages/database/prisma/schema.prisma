generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//* ==============ADMIN INFRASTRUCTURE====================

model AdminUser {
  id                  String                  @id @default(uuid())
  clerkUserId         String?                 @unique
  roleId              String?
  email               String                  @unique
  firstName           String
  middleName          String?
  lastName            String
  employeeId          String?                 @unique
  status              AdminUserStatus         @default(pending)
  invitationExpiresAt DateTime?
  isActive            Boolean                 @default(false)
  invitedById         String?
  invitationSentCount Int                     @default(0)
  invitationSentAt    DateTime?
  lastSeenAt          DateTime?
  deactivatedAt       DateTime?
  deactivationReason  String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  reviewAvailability  AdminReviewAvailability @default(AVAILABLE)
  unavailableFrom     DateTime?
  unavailableUntil    DateTime?
  unavailableReason   String?

  role          AdminRole?            @relation(fields: [roleId], references: [id])
  invitedBy     AdminUser?            @relation("AdminInvitedBy", fields: [invitedById], references: [id])
  invitees      AdminUser[]           @relation("AdminInvitedBy")
  scopes        AdminUserScope[]
  permissions   AdminUserPermission[] @relation("UserPermissions")
  granted       AdminUserPermission[] @relation("PermissionGrantedBy")
  auditLogs     AuditLog[]
  notifications AdminNotification[]

  @@index([clerkUserId])
  @@index([roleId])
  @@index([status])
  @@index([email])
  @@index([reviewAvailability])
}

enum AdminReviewAvailability {
  AVAILABLE
  UNAVAILABLE
}

//* Admin-facing in-app notification center — the AdminUser counterpart to
//* VendorNotification. Starts with one type (a stale-unclaimed compliance
//* case nudge, see compliance-case-sync.job.ts); metadata carries enough
//* to deep-link (e.g. vendorId/documentTypeId) without needing per-type
//* columns. Deliberately no email/push here — this is the in-app-only
//* notification the user asked for; email escalation for admins, if ever
//* needed, is a separate future decision, not assumed here.
model AdminNotification {
  id          String                @id @default(uuid())
  adminUserId String
  type        AdminNotificationType
  title       String
  message     String
  metadata    Json?
  isRead      Boolean               @default(false)
  readAt      DateTime?
  createdAt   DateTime              @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([adminUserId, isRead])
  @@index([createdAt])
}

enum AdminNotificationType {
  COMPLIANCE_CASE_STALE
  //* Vendor-appeal workflow rework (2026-08-28) — same three-event shape
  //* as the compliance-case notifications, plus a resolution notice (an
  //* appeal is a formal dispute someone is waiting on the outcome of, so
  //* the admin who logged it is notified when it's decided).
  APPEAL_STALE_UNCLAIMED
  APPEAL_ESCALATED
  APPEAL_RESOLVED
  //* Payout-account review workflow (2026-09-09) — the same escalate/assign
  //* pair the appeal queue uses. ESCALATED goes to every in-country
  //* RECEIVE_ESCALATION holder (open pool); ASSIGNED goes to one named
  //* admin after a supervisory reassignment.
  PAYOUT_ACCOUNT_ESCALATED
  PAYOUT_ACCOUNT_ASSIGNED
  //* A vendor public profile was just flagged by the automated content
  //* checks (profanity / impersonation / duplicate name) — fired at flag
  //* time on both create and edit, to VENDORS_PROFILES_MODERATE holders
  //* scoped to the vendor's country. PROFILE_STALE_FLAGGED below is the
  //* separate 24h "still unreviewed" nudge.
  PROFILE_FLAGGED
  //* Vendor public-profile flag sitting unactioned too long — same
  //* stale-alert shape as COMPLIANCE_CASE_STALE, gated on
  //* VENDORS_PROFILES_MODERATE instead of a dedicated receive-alert
  //* permission (see PROFILE_STALE_NOTIFY_HOURS's doc comment for why).
  PROFILE_STALE_FLAGGED
  //* An operational zone was suspended/paused/retired/reactivated, or its
  //* capability level changed. Sent to SETTINGS_ZONES_RECEIVE_ALERT holders
  //* scoped to the zone's city or country (never global). title/message
  //* carry the specifics; the split is only for category grouping.
  ZONE_STATUS_CHANGED
  ZONE_CAPABILITY_CHANGED
  //* An outlet was automatically taken offline because a CRITICAL document
  //* expired past its grace window. Sent to VENDORS_OUTLETS_MODERATE holders
  //* scoped to the outlet's country/city (never global).
  OUTLET_AUTO_SUSPENDED
  //* A vendor's new payout account landed in FAILED / REQUIRES_REVIEW at
  //* creation. Sent to VENDORS_PAYOUT_ACCOUNTS_MANAGE holders who are
  //* GLOBAL-scoped or COUNTRY-scoped to the vendor's country. Deep-links to
  //* the Finance → Vendor Payout Accounts review page.
  PAYOUT_ACCOUNT_NEEDS_REVIEW
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  createdAt   DateTime @default(now())

  users       AdminUser[]
  permissions AdminRolePermission[]
}

model AdminPermission {
  id          String  @id @default(uuid())
  key         String  @unique
  module      String
  description String?
  isActive    Boolean @default(true)

  roles AdminRolePermission[]
  users AdminUserPermission[]
}

model AdminRolePermission {
  roleId       String
  permissionId String

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminUserPermission {
  id           String   @id @default(uuid())
  adminUserId  String
  permissionId String
  grantedById  String
  grantedAt    DateTime @default(now())

  adminUser  AdminUser       @relation("UserPermissions", fields: [adminUserId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  AdminUser       @relation("PermissionGrantedBy", fields: [grantedById], references: [id])

  @@unique([adminUserId, permissionId])
  @@index([adminUserId])
  @@index([permissionId])
}

///* Geographic scope for an admin user.
/// scopeType = GLOBAL  → countryId and cityId are null
/// scopeType = COUNTRY → countryId set, cityId null
/// scopeType = CITY    → both set
///
///* Valid scope types per role (enforced at service layer):
///   super_admin     → GLOBAL only
///   identity_admin  → COUNTRY or GLOBAL (GLOBAL requires super_admin grant)
///   finance         → COUNTRY
///   vendor_ops      → COUNTRY or CITY
///   customer_care   → CITY or COUNTRY (city preferred)
///   courier_ops     → CITY only
///   operations_admin→ GLOBAL only (temporary — every market shares the same launch process for now)
model AdminUserScope {
  id          String         @id @default(uuid())
  adminUserId String
  scopeType   AdminScopeType
  countryId   String?
  cityId      String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  country   Country?  @relation(fields: [countryId], references: [id])
  city      City?     @relation(fields: [cityId], references: [id])

  @@unique([adminUserId, scopeType, countryId, cityId])
  @@index([adminUserId])
  @@index([countryId])
  @@index([cityId])
}

//* Append-only audit log across all models. Written asynchronously — never blocks a request.

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

//* Long-term audit record storage.
/**
 * Records are moved here from AuditLog after AUDIT_HOT_DAYS (90 days)
 * /// by the monthly audit-archive cron job.
 * /// Not shown in admin UI by default — accessible via export or direct query.
 * /// Deleted after AUDIT_DELETE_DAYS (730 days) by the same job.
 */
model AuditLogArchive {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  metadata    Json?
  createdAt   DateTime
  archivedAt  DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([archivedAt])
}

/// Predefined reasons for standard admin actions.
/// Selected by admin when taking an action — stored in AuditLog.metadata.reasonCode.
///
/// countryId null = global reason, available to every country.
/// countryId set  = country-specific override/addition for that code.
/// Resolution (see resolveActionReason): try [code, countryId] first,
/// fall back to [code, null]. Same optional-narrower-scope pattern as
/// DocumentTypeConfig's countryId/cityId — country-specific config is
/// additive, not mandatory per country.
model AdminActionReason {
  id          String   @id @default(uuid())
  code        String
  label       String
  description String?
  appliesTo   String[]
  countryId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([code, countryId])
  @@index([isActive])
  @@index([countryId])
}

/// Pre-computed summary metrics. Refreshed every 5 minutes by a background job.
model DashboardStat {
  key       String   @id
  value     Decimal  @db.Decimal(20, 4)
  updatedAt DateTime @updatedAt
  metadata  Json?
}

//* =========GEOGRAPHY & CONFIGURATION=============

model Region {
  id               String    @id @default(uuid())
  name             String    @unique // "East Africa", "West Africa"
  slug             String    @unique // "east-africa", "west-africa"
  code             String    @unique // "EAF", "WAF", "SAF" — short display code
  description      String?
  status           GeoStatus @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  countries Country[]

  @@index([status])
  @@index([slug])
}

model Country {
  id               String    @id @default(uuid())
  name             String    @unique
  code             String    @unique
  slug             String    @unique
  //* Legacy plain-string ISO code — retained for compatibility during the
  //* finance migration. New code should read `currencyCode` / `currencyRef`.
  currency         String
  currencySymbol   String?
  //* Finance Phase 1A — FK into the Currency reference table. Nullable
  //* while backfilling; the seed sets it for every country whose `currency`
  //* matches a seeded Currency row. Becomes the source of truth (and
  //* `currency` is dropped) in a later phase.
  currencyCode     String?
  currencyRef      Currency? @relation(fields: [currencyCode], references: [code])
  phoneCode        String
  timezones        String[]
  regionId         String?
  region           Region?   @relation(fields: [regionId], references: [id])
  status           GeoStatus @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime  @default(now())

  //* Go-live milestones, independent of `status`. Being ACTIVE means "we
  //* operate here" — it does NOT mean vendors can onboard or that customers
  //* should be advertised to yet. These flags cover the setup window
  //* (hiring, shop setup) between activation and actually opening up.
  //* readyForCustomerOperations is expected to only ever be set after
  //* readyForVendorOnboarding (enforced at the service layer, not here).
  readyForVendorOnboarding    Boolean   @default(false)
  vendorOnboardingReadyAt     DateTime?
  vendorOnboardingReadyById   String?
  readyForCustomerOperations  Boolean   @default(false)
  customerOperationsReadyAt   DateTime?
  customerOperationsReadyById String?

  //* Whether outlets in this country need a physical premises inspection,
  //* and when. See OutletInspectionPolicy. Admin-configurable; the default
  //* gates meal-plan eligibility only.
  outletInspectionPolicy OutletInspectionPolicy @default(MEAL_PLAN_ONLY)

  cities             City[]
  documentTypes      DocumentTypeConfig[]
  vendors            VendorAccount[]
  vendorApplications VendorApplication[]
  vendorTypes        VendorTypeCountry[]
  cuisines           CuisineCountry[]
  dietaryTags        DietaryTagCountry[]
  adminScopes        AdminUserScope[]

  //* Finance Phase 1B — a country's financial operating configuration
  //* (1:1) and its provider-account wiring (1:N, only one ACTIVE).
  financialConfig  CountryFinancialConfig?
  providerAccounts CountryProviderAccount[]
  taxRates         CountryTaxRate[]
  taxConfig        CountryTaxConfig?
  heroPromotions   HeroPromotion[]

  @@index([status])
  @@index([slug])
  @@index([regionId])
  @@index([currencyCode])
}

model City {
  id               String    @id @default(uuid())
  countryId        String
  name             String
  code             String?   @unique // system-generated, e.g. "NAIROBI_KENYA" — see admin.city.service.ts
  slug             String    @unique
  timezone         String
  latitude         Float? // centroid — Mapbox fly-to only
  longitude        Float? // centroid — Mapbox fly-to only
  status           GeoStatus @default(ACTIVE)
  createdByAdminId String?

  //* Deactivation audit trail — mirrors VendorAccount's suspensionReason/
  //* suspendedAt convention. Cleared back to null on reactivation.
  deactivatedByAdminId String?
  deactivatedAt        DateTime?
  deactivationReason   String?

  boundary        Json? // GeoJSON Polygon | MultiPolygon — city operational boundary
  boundingBox     Json? // { north, south, east, west }   — derived cache, never manual
  osmId           String? // OSM relation ID (numeric string) stored after OSM search
  boundarySource  String? // "OSM" | "MANUAL"
  boundarySetAt   DateTime?
  boundarySetById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country        Country              @relation(fields: [countryId], references: [id])
  documentTypes  DocumentTypeConfig[]
  zones          Zone[]
  marketSignals  MarketSignal[]
  serviceAreas   ServiceArea[]
  deliveryZones  DeliveryZone[]
  adminScopes    AdminUserScope[]
  heroPromotions HeroPromotion[]

  @@unique([countryId, name])
  @@index([countryId])
  @@index([status])
  @@index([slug])
}

//* =========OPERATIONAL ZONES=============
//
// Zone is the operational-policy container inside a City — the middle of the
// Vendor → Outlet → Zone → City hierarchy. Every outlet resolves to at most
// one zone (Outlet.zoneId). A location inside the city boundary that falls in
// no zone is treated as the REGISTRATION_ONLY floor by the resolver — no Zone
// row is required for that. Zones never exist outside the city boundary;
// everything outside is destination space only (see the geographic-operations
// review doc).
//
// Two orthogonal state axes, deliberately separate:
//   • `level`             — capability ladder (what is structurally possible
//                           here). Monotonic: each level includes every lower
//                           level's allowances. Changes ONLY by an explicit,
//                           audited admin decision. See ZONE_CAPABILITIES in
//                           @repo/geo for the level → flags mapping.
//   • `operationalStatus` — is the zone running right now. Suspending pauses
//                           orders/deliveries WITHOUT touching `level`;
//                           capability is preserved and restored by setting it
//                           back to ACTIVE.
// `status` (GeoStatus) is a third, structural axis matching ServiceArea/
// DeliveryZone/City: INACTIVE = the zone row has been retired/superseded and
// is excluded from point resolution entirely.
//
// Relationship to the legacy ServiceArea/ServiceAreaMode model below: Zone is
// its replacement, and Outlet has now fully moved across — Outlet.zoneId is
// the only geography an outlet carries. Outlet.serviceMode / isUnzoned and the
// OutletServiceArea join were dropped (2026-09-09) because nothing ever wrote
// them: every outlet sat at the INACTIVE default forever, so any code that had
// read them would have been reading a lie.
// ServiceArea itself is NOT dead and stays: DeliveryZone is validated against
// FULL_SERVICE areas, clearing a city boundary is blocked while any exist, and
// the country checklist counts them. Folding it into Zone is a real
// architectural decision about the courier layer, not a cleanup.
// DeliveryZone likewise stays — a distinct courier-capacity layer, not a
// capability container (a future rename to CourierZone is noted in the review
// doc, not done here).

model Zone {
  id         String @id @default(uuid())
  cityId     String
  name       String
  boundaries Json // GeoJSON Polygon | MultiPolygon — must sit within the city boundary (enforced at the service layer, a later stage)

  //* Capability ladder — see ZoneLevel. Monotonic. Promotion/demotion is an
  //* explicit admin decision informed by supply/demand data, never automatic.
  level                 ZoneLevel @default(REGISTRATION_ONLY)
  levelChangedAt        DateTime?
  levelChangedByAdminId String?
  levelChangeReason     String?

  //* Operational status — orthogonal to `level`. See ZoneOperationalStatus.
  //* `pausedUntil` is a planned-maintenance auto-resume hint; the job that
  //* acts on it is a later stage.
  operationalStatus            ZoneOperationalStatus @default(ACTIVE)
  operationalStatusReason      String?
  operationalStatusChangedAt   DateTime?
  operationalStatusChangedById String?
  pausedUntil                  DateTime?

  //* Record lifecycle (mirrors ServiceArea/DeliveryZone/City).
  status GeoStatus @default(ACTIVE)

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  outlets       Outlet[]
  marketSignals MarketSignal[]

  @@unique([cityId, name])
  @@index([cityId])
  @@index([status])
  @@index([level])
  @@index([operationalStatus])
}

//* =========MARKET SIGNALS=============
//
// Supply and demand collected AHEAD of operating somewhere — the two
// independent launch inputs that inform (never auto-trigger) an admin's
// decision to create a zone or promote one's level. A signal is captured at
// a point; if that point is inside a zone it's tagged with it, otherwise it
// counts toward the unzoned-inside-boundary or outside-boundary bucket.
// See the geographic-operations review doc's "Registration philosophy".
//
// CUSTOMER_INTEREST is captured with contact fields only for now —
// consumerAccountId waits for the customer app / a ConsumerAccount to point
// at. VENDOR_INTEREST may carry vendorAccountId when an existing vendor asks
// to expand.

model MarketSignal {
  id                 String           @id @default(uuid())
  type               MarketSignalType
  cityId             String
  zoneId             String?
  latitude           Float
  longitude          Float
  withinCityBoundary Boolean          @default(false)

  vendorAccountId String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  note            String?
  source          String? // "vendor_dashboard" | "admin" | "landing_page" | "customer_app"

  status            MarketSignalStatus @default(OPEN)
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  zone          Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  vendorAccount VendorAccount? @relation(fields: [vendorAccountId], references: [id], onDelete: SetNull)

  @@index([cityId, type, status])
  @@index([zoneId])
  @@index([status])
}

// Added: mode ServiceAreaMode — what level of service applies in this polygon.
//
// All four modes are stored as distinct ServiceArea records.
// The admin draws a polygon and assigns it a mode — all on the same page.
// EXCLUDED areas are stored but never returned by vendor/customer APIs.
//
// Any outlet location inside the city boundary but not covered by any
// ServiceArea polygon is treated as WAITLIST by the resolver (not UNZONED).

model ServiceArea {
  id               String          @id @default(uuid())
  cityId           String
  name             String
  boundaries       Json // GeoJSON Polygon | MultiPolygon
  mode             ServiceAreaMode @default(WAITLIST)
  status           GeoStatus       @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, name])
  @@index([cityId])
  @@index([status])
  @@index([mode])
}

// Permanent logistics zones — drawn by courier_ops on a SEPARATE admin page.
// Only valid inside FULL_SERVICE areas.
// No overlaps allowed within a city (backend warns, does not block).

model DeliveryZone {
  id               String    @id @default(uuid())
  cityId           String
  name             String
  boundaries       Json // GeoJSON Polygon | MultiPolygon
  status           GeoStatus @default(ACTIVE)
  maxCourierCount  Int?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  city       City                @relation(fields: [cityId], references: [id], onDelete: Cascade)
  batchZones MealPlanBatchZone[]

  @@unique([cityId, name])
  @@index([cityId])
  @@index([status])
}

// Ephemeral zone — computed ONCE after subscription window closes.
// Groups geographically close subscribers of a single meal plan.
// The same courier covers this zone for the ENTIRE meal plan lifecycle,
// delivering a different meal each day in the same time window.
// Individual daily delivery records are tracked elsewhere (order/delivery layer).
model MealPlanBatchZone {
  id              String          @id @default(uuid())
  code            String          @unique // auto-generated: "MP-{planId[:8]}-Z{n}"
  mealPlanId      String
  deliveryZoneId  String? // nearest permanent zone — nullable, reference only
  cityId          String // denormalised for queries
  boundaries      Json // GeoJSON Polygon — convex hull of subscriber cluster
  windowStart     String // "18:00" HH:MM — same every delivery day
  windowEnd       String // "19:00" HH:MM
  subscriberCount Int             @default(0)
  status          BatchZoneStatus @default(PENDING)
  computedAt      DateTime        @default(now())
  assignedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  mealPlan     MealPlan      @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])

  @@index([mealPlanId])
  @@index([deliveryZoneId])
  @@index([cityId])
  @@index([status])
}

//* =========FINANCE FOUNDATION (Phase 1A + 1B)==========
//* Platform-level financial reference data + per-country financial
//* configuration. DailyBread owns the financial source of truth; payment
//* providers (Flutterwave/Stripe/…) are rails. See
//* apps/backend/src/modules/finance. Phase 1A: Currency + PaymentProvider
//* catalog. Phase 1B: CountryFinancialConfig + CountryProviderAccount.
//* Still deliberately NOT here: ledger / payments / payouts / settlement /
//* reconciliation — later phases.

//* ISO-4217 currency reference. Exists so the financial domain never
//* treats currency as an arbitrary string — an amount is always
//* (integer minor units + a currency that resolves here). `code` is the
//* natural key (e.g. "KES", "USD"). Country.currency (a plain string) is
//* kept during migration; Country.currencyCode is the new FK.
model Currency {
  code             String                 @id // ISO-4217, uppercase
  name             String // "Kenyan Shilling"
  symbol           String? // "KSh"
  //* Number of decimal places the currency's minor unit uses — 2 for most
  //* (KES/USD/EUR), 0 for JPY/UGX-style, 3 for BHD/KWD. Drives how an
  //* amountMinor integer maps to a human-facing value; never assumed to be 2.
  minorUnitDigits  Int                    @default(2)
  status           FinanceReferenceStatus @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  countries        Country[]
  financialConfigs CountryFinancialConfig[]

  @@index([status])
}

//* Platform catalog of payment-provider IMPLEMENTATIONS the system knows
//* how to talk to (Flutterwave, Stripe, …). This is NOT provider
//* credentials and NOT a per-country wiring — it only declares what a
//* provider IS and what it CAN do. Credentials stay outside the DB
//* (see ProviderSecretsResolver); per-country wiring
//* (CountryProviderAccount) is a later phase. `capabilities` is the
//* declared capability set the future adapter is expected to implement —
//* a country can only enable a financial operation whose provider
//* declares the matching capability here.
model PaymentProvider {
  id                  String                      @id @default(uuid())
  code                String                      @unique // "FLUTTERWAVE", "STRIPE"
  name                String
  status              FinanceReferenceStatus      @default(ACTIVE)
  capabilities        PaymentProviderCapability[] // declared; empty = nothing enabled
  //* Which PaymentMethod.type values this provider can handle at all —
  //* kept coherent with `capabilities` at the service layer
  //* (validateProviderCapabilityCoherence).
  methodTypes         PaymentMethodType[]
  //* ISO-4217 codes the provider supports; empty = unrestricted / not yet declared.
  supportedCurrencies String[]
  description         String?
  createdByAdminId    String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  countryAccounts CountryProviderAccount[]

  @@index([status])
}

//* A configured provider account belonging to one country. This is the
//* "Kenya uses THIS Flutterwave account, in THIS environment" layer —
//* distinct from PaymentProvider ("Flutterwave exists") and from
//* CountryFinancialConfig ("Kenya's financial settings").
//*
//* Append-only by policy: never hard-deleted (historical financial
//* records will attribute to a specific account id) — retired via
//* status = DISABLED only.
//*
//* A country may have MANY ACTIVE accounts at once — one per capability
//* domain (e.g. collection via Provider A, payout via Provider B,
//* bank-account verification via Provider C). There is no "the country's
//* active/primary account": every runtime provider call resolves a
//* specific account by explicit routing context —
//* CountryPaymentMethod.countryProviderAccountId for method-specific
//* business capabilities, CountryFinancialConfig.bankVerificationProviderAccountId
//* for the country-global bank-account-resolution/verification capability.
//* See finance.providerGateway.service.ts (resolveProviderGateway).
//*
//* Secrets (API keys, webhook signing secrets) are NEVER stored here.
//* `secretAlias` is a non-secret pointer resolved by ProviderSecretsResolver.
model CountryProviderAccount {
  id                  String                       @id @default(uuid())
  countryId           String
  paymentProviderId   String
  environment         PaymentEnvironment
  //* Non-secret reference, e.g. "flutterwave_ke_primary". The actual
  //* credentials live outside the DB (env / secret manager).
  secretAlias         String
  //* Which of the provider's declared capabilities this account turns on
  //* for this country. MUST be a subset of PaymentProvider.capabilities
  //* (validateProviderCapabilityCoherence + assertEnabledSubsetOfProvider).
  enabledCapabilities PaymentProviderCapability[]
  accountLabel        String?
  //* The provider's own merchant/account identifier — a non-secret id used
  //* for reconciliation, safe to store.
  externalAccountId   String?
  status              CountryProviderAccountStatus @default(DRAFT)

  activatedAt        DateTime?
  activatedByAdminId String?
  suspendedAt        DateTime?
  suspendedByAdminId String?
  suspensionReason   String?
  disabledAt         DateTime?
  disabledByAdminId  String?

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country                    Country                  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  paymentProvider            PaymentProvider          @relation(fields: [paymentProviderId], references: [id])
  //* The country-global bank-account verification/resolution bindings that
  //* point at this account. Keyed on (id, countryId) — same DB-enforced
  //* same-country guarantee as paymentMethods below. Modelled as a list for
  //* Prisma's sake (many-to-one, like paymentMethods); in practice at most
  //* one row, since CountryFinancialConfig is 1:1 with Country and the FK is
  //* same-country.
  bankVerificationForConfigs CountryFinancialConfig[] @relation("BankVerificationProviderAccount")
  //* Finance Phase 1C — the country payment methods routed through this
  //* account. The relation is keyed on (id, countryId) so a method can
  //* NEVER be wired to another country's provider account (DB-enforced, not
  //* just service-checked) — see CountryPaymentMethod.countryProviderAccount.
  paymentMethods             CountryPaymentMethod[]

  @@unique([id, countryId])
  @@index([countryId, status])
  @@index([paymentProviderId])
  @@index([status])
}

//* A country's financial operating configuration (1:1 with Country).
//* One mutable row — NOT versioned; historical attribution is preserved
//* by transactions snapshotting the CountryProviderAccount id + currency
//* they occurred under, and by provider accounts never being deleted.
//*
//* "Config row exists" != "country is financially operational". Operational
//* requires status = ACTIVE, an ACTIVE currency, the relevant enabled
//* switch, and — per capability — a usable CountryProviderAccount reachable
//* through explicit routing (method wiring for collection/payout,
//* bankVerificationProviderAccountId for bank-account verification). See the
//* readiness predicates in finance.readiness.service.ts.
//*
//* Provider routing is capability-scoped and explicit — there is no single
//* "active provider account" for the country. Method-specific business
//* capabilities (collection/payout) route via
//* CountryPaymentMethod.countryProviderAccountId; the country-global
//* bank-account-resolution/verification capability routes via
//* bankVerificationProviderAccountId below. A country may use the same
//* provider for all of them, or a different provider for each.
model CountryFinancialConfig {
  id                                String                       @id @default(uuid())
  countryId                         String                       @unique
  currencyCode                      String?
  //* Country-global routing binding for the BANK_ACCOUNT_RESOLUTION /
  //* BANK_LIST capability (automatic vendor payout-account verification +
  //* the bank directory the vendor picks from — one provider by nature).
  //* Independent of collection/payout routing: NEVER inferred from a
  //* payment method's provider account. Nullable — unset means the country
  //* has no automatic bank verification yet (vendor payout accounts fall to
  //* the offline structural-check + manual-review path, unchanged). The FK
  //* is composite — (id, countryId) → (id, countryId) — so it can NEVER
  //* point at another country's provider account (DB-enforced).
  bankVerificationProviderAccountId String?
  //* HOW this country verifies a vendor's bank payout account. Distinct from
  //* the routing binding above: that says WHO verifies, this says WHETHER an
  //* automated verifier is expected at all.
  //*   PROVIDER — a usable bankVerificationProviderAccount is required, and
  //*     readiness fails without one (e.g. Nigeria via dLocal).
  //*   MANUAL   — no provider can verify bank accounts in this market (e.g.
  //*     Kenya: no PSP offers KES name enquiry). The vendor uploads a proof
  //*     document (a PAYOUT_ACCOUNT-scoped DocumentTypeConfig) and an admin
  //*     verifies it by hand. A legitimate operating mode, not a gap —
  //*     readiness passes without a bound provider account.
  //* The two paths are deliberately SEPARATE: a PROVIDER-mode country never
  //* offers a manual document fallback, and a MANUAL-mode country never
  //* calls a provider. (A failure-driven fallback is a later decision.)
  bankVerificationMode              BankVerificationMode         @default(PROVIDER)
  //* Operational switches — the admin's deliberate "we are collecting /
  //* paying out here" decision, distinct from "the provider can technically
  //* do it". Mutable while ACTIVE (validated + audited).
  collectionsEnabled                Boolean                      @default(false)
  payoutsEnabled                    Boolean                      @default(false)
  status                            CountryFinancialConfigStatus @default(DRAFT)

  activatedAt        DateTime?
  activatedByAdminId String?
  suspendedAt        DateTime?
  suspendedByAdminId String?
  suspensionReason   String?
  disabledAt         DateTime?
  disabledByAdminId  String?

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country                         Country                 @relation(fields: [countryId], references: [id], onDelete: Cascade)
  currency                        Currency?               @relation(fields: [currencyCode], references: [code])
  //* NoAction (not SetNull): Prisma forbids SetNull on a composite FK whose
  //* countryId leg is non-nullable — same reason CountryPaymentMethod uses
  //* NoAction. A provider account is never hard-deleted (retired via
  //* DISABLED), and disableProviderAccount explicitly nulls this pointer.
  bankVerificationProviderAccount CountryProviderAccount? @relation("BankVerificationProviderAccount", fields: [bankVerificationProviderAccountId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction, map: "CountryFinancialConfig_bankVerification_fkey")

  @@index([status])
  @@index([currencyCode])
  @@index([bankVerificationProviderAccountId])
}

//* =========CONSUMPTION TAX==========
//*
//* Tax is JURISDICTIONAL, and within one jurisdiction the rate depends on
//* WHAT the food is — in the UK a hot takeaway meal is standard-rated while
//* the same shop's cold sandwich is zero-rated, and several US states and
//* Canadian provinces draw comparable lines. A single rate per country is
//* therefore wrong in most markets, which is why Uber Eats carries a tax
//* category on the menu item rather than a store-wide rate.
//*
//* Shape is the global-catalog-plus-per-country-config pattern this schema
//* already uses four times (VendorType/VendorTypeCountry,
//* Cuisine/CuisineCountry, DietaryTag/DietaryTagCountry,
//* PaymentMethod/CountryPaymentMethod): TaxCategory is the platform's
//* vocabulary, CountryTaxRate is what ONE country charges for ONE category.
//* A flat-rate market configures exactly one category and its vendors never
//* meet the concept — MenuItem.taxCategoryId stays null and resolution falls
//* back to that country's standard rate.
//*
//* Deliberately NOT effective-dated, and deliberately no separate history
//* table. An order line snapshots the rate it was charged at, so "what rate
//* applied to this order" is answerable from the order; "when did this
//* country's rate change" is answerable from the append-only AuditLog, which
//* every mutation already writes. A third record of the same fact could only
//* disagree with the other two.

//* One country's tax POSITION: how prices are quoted here, who is legally
//* the collector, and what the tax is called. Deliberately a table of its own
//* rather than columns on CountryFinancialConfig: the tax module owns its own
//* data so it stays independently extractable, and finance owns payment
//* rails, which is a different concern that merely sits adjacent. 1:1 with
//* Country, mirroring CountryFinancialConfig's shape.
model CountryTaxConfig {
  id        String @id @default(uuid())
  countryId String @unique

  //* Whether a menu price already contains tax. Kenya, the UK, the EU and
  //* most of Africa quote tax-inclusive prices; the United States adds it at
  //* checkout. Default inclusive because it is the wider convention and the
  //* safer wrong answer: an inclusive price read as exclusive under-charges,
  //* while the reverse over-charges the customer.
  pricesIncludeTax Boolean     @default(true)
  //* Who is legally the collector. VENDOR is the default and the lighter
  //* model, but this is NOT a business preference everywhere: marketplace
  //* facilitator rules in several jurisdictions force the platform to collect
  //* and remit regardless. Hence a column, not a platform policy.
  taxRemittedBy    TaxRemitter @default(VENDOR)
  //* What this market calls it — "VAT", "GST", "Sales Tax". Shown to vendors
  //* and customers verbatim. Null falls back to a generic "Tax".
  taxName          String?

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
}

model TaxCategory {
  id          String  @id @default(uuid())
  //* Stable identifier. name and slug are both admin-editable, so keying
  //* seeds or code on either would duplicate on the first rename — same
  //* reasoning as the cuisine and dietary-tag catalogs.
  code        String  @unique // "STANDARD", "ZERO_RATED", "EXEMPT"
  slug        String  @unique
  name        String
  description String?

  status           TaxonomyStatus @default(ACTIVE)
  createdByAdminId String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  countryRates CountryTaxRate[]
  menuItems    MenuItem[]

  @@index([status])
  @@index([deletedAt])
}

//* What one country charges for one tax category.
model CountryTaxRate {
  id            String @id @default(uuid())
  countryId     String
  taxCategoryId String

  //* BASIS POINTS, integer — 1600 is 16.00%. A rate multiplies money, so a
  //* float here reintroduces exactly the representation problem minor units
  //* were adopted to avoid; bps also expresses a fractional statutory rate
  //* (7.5% = 750) exactly.
  rateBps Int

  //* The fallback for a dish that names no category. Exactly one ACTIVE row
  //* per country may set this, enforced by a partial unique index in the
  //* migration rather than by the service alone.
  isStandard Boolean   @default(false)
  status     GeoStatus @default(ACTIVE)

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country     Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  taxCategory TaxCategory @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)

  @@unique([countryId, taxCategoryId])
  @@index([countryId])
  @@index([taxCategoryId])
  @@index([status])
}

//* =========PAYMENT CONFIGURATION==========

model PaymentMethod {
  id               String             @id @default(uuid())
  code             String             @unique // "MPESA", "BANK_TRANSFER", "PAYPAL", "AIRTEL_MONEY"
  name             String
  type             PaymentMethodType // MOBILE_MONEY | BANK | DIGITAL_WALLET | CARD
  direction        PaymentDirection[] // [INBOUND, OUTBOUND] — can it collect? can it pay out?
  logoUrl          String?
  description      String?
  createdByAdminId String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())

  countryConfigs CountryPaymentMethod[]
}

model CountryPaymentMethod {
  id              String                     @id @default(uuid())
  countryId       String
  paymentMethodId String
  direction       PaymentDirection // INBOUND or OUTBOUND
  status          CountryPaymentMethodStatus @default(ACTIVE)

  //* Finance Phase 1C — which CountryProviderAccount actually executes this
  //* method for this country (the explicit answer to "which provider
  //* handles M-Pesa collection in Kenya", instead of inferring it from
  //* capability overlap). Nullable: a method can exist before it's wired.
  //* The FK is composite — (accountId, countryId) → (id, countryId) — so a
  //* method physically cannot reference another country's account.
  countryProviderAccountId String?

  // Our own collection/disbursement account details for this method in this country
  // Stored as JSON because M-Pesa needs a paybill, bank needs account+branch, PayPal needs email
  ourAccountDetails Json?

  // Verification provider config for vendor account validation
  verificationProvider String? // "AFRICASTALKING", "SAFARICOM_DARAJA", "MANUAL"
  verificationConfig   Json? // provider-specific config, API keys stored in env but config here
  displayOrder         Int     @default(0)

  createdByAdminId String?
  createdAt        DateTime @default(now())

  paymentMethod          PaymentMethod           @relation(fields: [paymentMethodId], references: [id])
  //* NoAction: a provider account is never hard-deleted (retired via
  //* status = DISABLED), and the wiring service nulls this pointer when an
  //* account is disabled — so there's nothing for a cascade to do here.
  countryProviderAccount CountryProviderAccount? @relation(fields: [countryProviderAccountId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction)
  vendorPayoutAccounts   VendorPayoutAccount[]

  @@unique([countryId, paymentMethodId, direction])
  @@index([countryId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([countryProviderAccountId])
}

//* Finance Phase 1C — the provider-event idempotency boundary. Every
//* payment-provider webhook that passes signature verification is recorded
//* here exactly once, keyed by the provider's own event id. This is NOT a
//* ledger, an event store, or a reconciliation engine — it exists solely so
//* "same provider event delivered twice => processed once" holds. In Phase
//* 1C nothing downstream consumes these rows (status stays RECEIVED); a
//* later phase adds the finance-event processor that flips them to
//* PROCESSED / SKIPPED. Invalid-signature requests are rejected at the edge
//* and never stored.
model ProviderWebhookEvent {
  id                       String                     @id @default(uuid())
  //* PaymentProvider.code, e.g. "FLUTTERWAVE" — a plain string, not an FK,
  //* because a webhook is infrastructure that must record even for a
  //* provider row that was later removed from the catalog.
  provider                 String
  //* The provider's own id for this event delivery (Flutterwave: payload
  //* `id`). Unique per provider — the idempotency key.
  providerEventId          String
  //* Normalized NormalizedWebhookEventType ("PAYMENT_SUCCEEDED", …).
  eventType                String
  //* Provider id of the affected transaction/payout/refund, when the
  //* payload carried one — lets a later processor find the local record.
  providerRef              String?
  //* Which country provider account the verified signature matched — null
  //* only if the event verified against a provider-level (non-account)
  //* secret, which no current provider uses.
  countryProviderAccountId String?
  status                   ProviderWebhookEventStatus @default(RECEIVED)
  //* The exact provider payload as received (parsed JSON). Retained for
  //* audit / replay / support. Never read by business logic — a later
  //* processor works off the normalized fields above.
  payload                  Json
  receivedAt               DateTime                   @default(now())
  processedAt              DateTime?

  @@unique([provider, providerEventId])
  @@index([provider, eventType])
  @@index([status])
  @@index([providerRef])
}

model VendorCommissionConfig {
  id               String   @id @default(uuid())
  countryId        String   @unique // country-level default
  //* BASIS POINTS — 1500 is 15%. Was a Float holding a fraction while
  //* VendorAccount held a percentage; see the note there.
  rateBps          Int
  effectiveFrom    DateTime @default(now())
  createdByAdminId String?
  createdAt        DateTime @default(now())

  @@index([countryId])
}

//* ==========VENDORS==============

model VendorType {
  id               String           @id @default(uuid())
  name             String           @unique
  slug             String           @unique
  description      String?
  status           VendorTypeStatus @default(ACTIVE)
  createdByAdminId String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())

  documentTypeConfigs DocumentTypeVendorType[]
  vendorAccounts      VendorAccount[]
  vendorApplications  VendorApplication[]
  countries           VendorTypeCountry[]

  @@index([status])
}

model VendorTypeCountry {
  id               String    @id @default(uuid())
  countryId        String
  vendorTypeId     String
  status           GeoStatus @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime  @default(now())

  country    Country    @relation(fields: [countryId], references: [id])
  vendorType VendorType @relation(fields: [vendorTypeId], references: [id])

  @@unique([countryId, vendorTypeId])
  @@index([countryId])
  @@index([vendorTypeId])
  @@index([status])
}

model DocumentTypeConfig {
  id                 String                     @id @default(uuid())
  name               String
  code               String
  description        String?
  scope              DocumentScope
  isInheritable      Boolean                    @default(false)
  countryId          String
  cityId             String?
  isRequired         Boolean                    @default(true)
  requiresExpiry     Boolean                    @default(true)
  expiryWarningDays  Int                        @default(30)
  //* Compliance framework (phase 2) — see admin.vendor.compliance.service.ts.
  //* complianceSeverity: how urgent an issue on this document type is,
  //* shown/sorted on /vendors/compliance — purely informational today, no
  //* automatic enforcement reads it yet.
  //* gracePeriodDays: tolerance window after expiryDate before an expired
  //* document counts as a hard EXPIRED issue instead of the softer
  //* "in grace period" state.
  //* enforcedFrom: when set, a vendor missing this (now-required) document
  //* only becomes a MISSING compliance issue once this date has passed —
  //* lets a newly-added requirement roll out with a transition window
  //* instead of instantly flagging every existing vendor. Null = enforced
  //* immediately (the default for a type with no rollout need).
  complianceSeverity DocumentComplianceSeverity @default(MEDIUM)
  gracePeriodDays    Int                        @default(0)
  enforcedFrom       DateTime?
  instructions       String?
  sampleUrl          String?
  status             DocumentTypeStatus         @default(ACTIVE)
  createdByAdminId   String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  //* Deactivation audit trail — mirrors VendorAccount's suspensionReason/
  //* suspendedAt convention. Cleared back to null on reactivation.
  deactivatedByAdminId String?
  deactivatedAt        DateTime?
  deactivationReason   String?

  city              City?                       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  country           Country                     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  vendorTypeConfigs DocumentTypeVendorType[]
  storeDocuments    OutletDocument[]
  storeInheritances OutletDocumentInheritance[]
  vendorDocuments   VendorDocument[]
  complianceWaivers VendorComplianceWaiver[]
  complianceCases   VendorComplianceCase[]

  @@unique([code, countryId, cityId])
  @@index([countryId])
  @@index([cityId])
  @@index([scope, countryId, cityId])
}

model DocumentTypeVendorType {
  id             String   @id @default(uuid())
  documentTypeId String
  vendorTypeId   String
  isRequired     Boolean  @default(true)
  createdAt      DateTime @default(now())

  documentType DocumentTypeConfig @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  vendorType   VendorType         @relation(fields: [vendorTypeId], references: [id], onDelete: Cascade)

  @@unique([documentTypeId, vendorTypeId])
  @@index([documentTypeId])
  @@index([vendorTypeId])
}

//* Compliance framework (phase 3) — an admin-granted exception that
//* suppresses one vendor+documentType compliance issue (of any kind —
//* MISSING, EXPIRED, EXPIRING_SOON) from counting toward "open issues"
//* until it expires, without faking the underlying document as approved.
//* Vendor-scoped only for now (VendorComplianceWaiver, not a generic
//* polymorphic waiver) — when outlet administration is built, an
//* analogous OutletComplianceWaiver is the expected shape, not a
//* migration of this model; see CLAUDE.md's compliance section.
model VendorComplianceWaiver {
  id               String   @id @default(uuid())
  vendorId         String
  documentTypeId   String
  reason           String
  expiresAt        DateTime
  grantedByAdminId String

  //* Revocation, not deletion — an admin can end a waiver early, but the
  //* record (and who granted it) stays in the audit trail.
  revokedAt        DateTime?
  revokedByAdminId String?
  revokedReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor       VendorAccount      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documentType DocumentTypeConfig @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([documentTypeId])
  @@index([expiresAt])
}

//* Compliance case workflow (phase "claim/escalate", 2026-08-25) — a
//* persistent, claimable/escalatable record of one open compliance issue,
//* modeled deliberately close to VendorApplication's review workflow
//* (assignedReviewerId/escalatedByAdminId/escalationReason) so the two
//* feel like siblings, not two different systems. Distinct from
//* VendorComplianceWaiver (an exception on the underlying issue) — a case
//* can be OPEN/CLAIMED/ESCALATED while a waiver is separately granted or
//* not; when it is, the case moves to WAIVED too (see
//* admin.vendor.compliance-case.service.ts).
//*
//* Kept in sync with live detection (getComplianceOverview's candidate
//* list) by a periodic reconciliation job
//* (jobs/vendor/compliance-case-sync.job.ts), not synchronously on every
//* read — same "detect on a schedule, not instantly" philosophy as the
//* document-expiry cron. A case for an issue that no longer exists (the
//* vendor fixed it) is auto-marked RESOLVED by that same job.
model VendorComplianceCase {
  id             String                     @id @default(uuid())
  vendorId       String
  documentTypeId String
  issueType      ComplianceIssueKind
  //* Snapshotted from DocumentTypeConfig.complianceSeverity at case-open
  //* time — a later severity edit on the document type shouldn't silently
  //* rewrite the urgency of a case already being worked.
  severity       DocumentComplianceSeverity
  status         ComplianceCaseStatus       @default(OPEN)

  assignedReviewerId String?
  assignedAt         DateTime?

  //* Escalation — permanent, non-clearing marker, same convention as
  //* VendorApplication.escalatedByAdminId: the escalating admin is locked
  //* out of claiming this case again. Claimable from the open-escalation
  //* pool only by holders of VENDORS_COMPLIANCE_RECEIVE_ESCALATION who are
  //* ALSO country-scoped to the vendor's own country — deliberately
  //* excludes globally-scoped admins, unlike the applications escalation
  //* pool (see claimEscalatedComplianceCase). Compliance follow-up stays
  //* with the local country team.
  escalatedByAdminId String?
  escalatedAt        DateTime?
  escalationReason   String?

  //* Roadmap "compliance case workflow refinement" (CLAUDE.md) — true only
  //* while the CURRENT assignment was obtained by self-service claiming
  //* out of the open escalation pool (claimComplianceCase's escalation
  //* branch). Distinct from escalatedByAdminId (which is permanent and
  //* tracks WHO escalated, for their own lock-out) — this tracks HOW the
  //* current holder got it, and gates whether THEY may escalate again:
  //* a self-service escalation claim is terminal (must resolve directly),
  //* but a reassignment (even one that lands on the same admin, or one
  //* that hands an already-escalated case to someone new) resets this to
  //* false, since reassignment is a deliberate supervisory hand-off, not
  //* the admin opting into being the end of the line.
  claimedFromEscalation Boolean @default(false)

  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolutionNote    String?

  notifiedCount  Int       @default(0)
  lastNotifiedAt DateTime?

  //* Set once the 24h-unclaimed stale alert has fired for this case (see
  //* COMPLIANCE_CASE_STALE_NOTIFY_HOURS, compliance-case-sync.job.ts) —
  //* prevents re-notifying every cron run. Independent of the separate
  //* 7-day auto-escalation threshold (COMPLIANCE_CASE_STALE_DAYS) — this
  //* is a softer, earlier nudge to designated staff, not an escalation.
  staleNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor       VendorAccount      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documentType DocumentTypeConfig @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([documentTypeId])
  @@index([status])
  @@index([assignedReviewerId, status])
  @@index([escalatedByAdminId, status])
}

//* Vendor-facing notifications (compliance for now — deliberately generic
//* enough to carry other types later). Backend-only for this pass: writes
//* here, plus the vendor-facing read/list route, exist so the data is
//* ready the moment vendor-dashboard work picks this up — no
//* vendor-dashboard UI reads it yet (see CLAUDE.md).
model VendorNotification {
  id        String                 @id @default(uuid())
  vendorId  String
  type      VendorNotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean                @default(false)
  readAt    DateTime?
  createdAt DateTime               @default(now())

  vendor VendorAccount @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([vendorId, isRead])
  @@index([createdAt])
}

//* Roadmap Phase 2 (CLAUDE.md) — VendorAccount.commissionRate was a
//* mutable field with no admin action to change it and no record of what
//* it was when. This is that record; admin.vendor.commission.service.ts
//* is what actually writes both this and the live commissionRate together.
model VendorCommissionRateHistory {
  id               String   @id @default(uuid())
  vendorId         String
  //* BASIS POINTS, matching VendorAccount.commissionRateBps.
  previousRateBps  Int?
  newRateBps       Int
  reason           String?
  changedByAdminId String
  createdAt        DateTime @default(now())

  vendor VendorAccount @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([createdAt])
}

model VendorUser {
  id        String    @id @default(uuid())
  clerkId   String    @unique
  email     String    @unique
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  isBanned  Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendorAccount VendorAccount?
  application   VendorApplication?

  @@index([clerkId])
  @@index([email])
}

model VendorAccount {
  id                    String         @id @default(uuid())
  userId                String?        @unique
  vendorTypeId          String
  otherVendorType       String?
  countryId             String
  applicationId         String         @unique
  status                VendorStatus   @default(ACTIVE)
  legalBusinessName     String
  businessEmail         String         @unique
  businessPhone         String
  companyRegNumber      String?
  taxRegistrationNumber String?
  taxIdType             String?
  ownerFirstName        String
  ownerLastName         String
  ownerPhone            String?
  ownerEmail            String?
  businessAddress       String
  addressLine2          String?
  postalCode            String?
  //* BASIS POINTS, integer — 1500 is 15.00%. A rate multiplies money, so a
  //* float reintroduces exactly the representation problem minor units exist
  //* to avoid, and bps expresses a negotiated 12.5% exactly. Same convention
  //* as CountryTaxRate.rateBps.
  //*
  //* This also settles a real ambiguity: the old Float here held a PERCENTAGE
  //* (15 meant 15%) while VendorCommissionConfig.rate held a FRACTION (0.15
  //* meant the same thing). One concept, two scales, and nothing in the type
  //* system to catch a mix-up. There is now one scale.
  commissionRateBps     Int?
  payoutSchedule        PayoutSchedule @default(BIWEEKLY)
  nextPayoutDate        DateTime?
  addressVerified       Boolean        @default(false)
  suspensionReason      String?
  suspendedAt           DateTime?
  suspensionUntil       DateTime?
  deactivatedAt         DateTime?
  deletedAt             DateTime?

  //* Payout hold — designed, not enforced (no payout run to gate yet). See PayoutHoldStatus.
  payoutHoldStatus   PayoutHoldStatus @default(NONE)
  payoutHoldReason   String?
  payoutHoldPlacedAt DateTime?
  payoutHoldPlacedBy String? // adminUserId
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  country               Country                       @relation(fields: [countryId], references: [id])
  user                  VendorUser?                   @relation(fields: [userId], references: [id])
  vendorType            VendorType                    @relation(fields: [vendorTypeId], references: [id])
  application           VendorApplication?            @relation("ApplicationToAccount", fields: [applicationId], references: [id])
  outlets               Outlet[]
  documents             VendorDocument[]
  payoutAccounts        VendorPayoutAccount[]
  vendorProfile         VendorProfile?
  complianceWaivers     VendorComplianceWaiver[]
  complianceCases       VendorComplianceCase[]
  notifications         VendorNotification[]
  commissionRateHistory VendorCommissionRateHistory[]
  appeals               VendorAppeal[]
  marketSignals         MarketSignal[]
  menuSections          MenuSection[]
  menuItems             MenuItem[]
  modifierGroups        ModifierGroup[]
  discounts             Discount[]

  @@unique([companyRegNumber, countryId])
  @@unique([taxRegistrationNumber, countryId])
  @@unique([businessPhone, countryId])
  @@index([userId])
  @@index([countryId])
  @@index([status])
  @@index([businessEmail])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([countryId, status])
}

model VendorProfile {
  id                  String    @id @default(uuid())
  vendorAccountId     String    @unique
  displayName         String
  tagline             String?
  description         String?
  story               String?
  //* R2 storage KEYS, not public URLs — the bucket is private, so every read
  //* goes out as a short-lived signed URL generated at response time
  //* (presentVendorProfile). Named ...StorageKey rather than ...Url precisely
  //* so nobody renders one directly into an <img src>.
  logoStorageKey      String?
  coverStorageKey     String?
  publicEmail         String?
  publicPhone         String?
  website             String?
  socialLinks         Json?
  //* No reservationLink and no photo gallery, deliberately — see the note on
  //* galleryStorageKeys' removal in the 2026-09-10 migration. Both point at a
  //* physical venue, which a delivery-only marketplace has no reason to
  //* publish. Uber Eats / DoorDash / Bolt Food carry neither.
  primaryCuisineId    String?
  foundedYear         Int?
  totalReviews        Int       @default(0)
  averageRating       Float     @default(0)
  isVerifiedBadge     Boolean   @default(false)
  isTopRated          Boolean   @default(false)
  isCommunityFavorite Boolean   @default(false)
  isPublished         Boolean   @default(false)
  isFeatured          Boolean   @default(false)
  //* Unused today, kept as-is: no vendor-facing writer and no admin surface.
  videoUrls           String[]
  publishedAt         DateTime?

  //* Profanity/impersonation flagging — mirrors Outlet's reviewStatus/
  //* flagReasons/flaggedAt convention exactly (see runFlagChecks in
  //* vendor.outlet.service.ts). A profile can only be published while
  //* reviewStatus is AUTO_APPROVED or MANUALLY_APPROVED — see
  //* publishVendorProfile in vendor.profile.service.ts.
  reviewStatus      ProfileReviewStatus @default(AUTO_APPROVED)
  flagReasons       String[]
  //* Field-granular breakdown behind flagReasons — an array of
  //* { field, reason, match? } so a moderator sees which field tripped
  //* which check and the offending token/brand, not just a bare reason
  //* list. Recomputed alongside flagReasons whenever profile copy changes.
  flagDetails       Json?
  flaggedAt         DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  //* Set on MANUALLY_REJECTED — shown to the vendor so they know what to
  //* fix. Cleared on the next edit (recomputed flags supersede it).
  rejectionReason   String?

  //* Set once the stale-flagged alert has fired for this profile (see
  //* PROFILE_STALE_NOTIFY_HOURS, vendor-ops-notifications.job.ts) —
  //* prevents re-notifying every cron run. Cleared on the next edit that
  //* recomputes flags, same convention as rejectionReason above — a fresh
  //* edit deserves a fresh notification clock, not a suppressed one.
  staleNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryCuisine Cuisine?                  @relation(fields: [primaryCuisineId], references: [id])
  vendorAccount  VendorAccount             @relation(fields: [vendorAccountId], references: [id], onDelete: Cascade)
  //* Replaced the free-text specialties[] / dietaryOptions[] columns — see the
  //* FOOD TAXONOMY block above for why.
  cuisines       VendorProfileCuisine[]
  dietaryTags    VendorProfileDietaryTag[]

  @@index([vendorAccountId])
  @@index([displayName])
  @@index([primaryCuisineId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([averageRating])
  @@index([createdAt])
  @@index([totalReviews])
  @@index([reviewStatus])
}

enum ProfileReviewStatus {
  AUTO_APPROVED // Passed all coded checks — publishable immediately
  FLAGGED // Failed one or more coded checks — in admin queue, cannot be published
  MANUALLY_APPROVED // Admin reviewed and cleared it — publishable
  MANUALLY_REJECTED // Admin reviewed and rejected — cannot be published, force-unpublished if it already was
}

model VendorApplication {
  id                 String                  @id @default(uuid())
  userId             String?                 @unique
  countryId          String
  vendorTypeId       String
  otherVendorType    String?
  legalBusinessName  String?
  registrationNumber String?
  taxId              String?
  businessEmail      String?
  businessPhone      String?
  ownerFirstName     String?
  ownerLastName      String?
  ownerPhone         String?
  ownerEmail         String?
  businessAddress    String?
  addressLine2       String?
  postalCode         String?
  status             VendorApplicationStatus @default(DRAFT)
  revisionCount      Int                     @default(0)
  rejectionReason    String?
  revisionNotes      String?
  reasonCode         String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  approvedAt         DateTime?

  //* Roadmap Phase 2 (CLAUDE.md) — legal/audit trail for "did they agree
  //* to something, and which version." Set by submitApplication when the
  //* submitting client sends termsVersion (vendor-dashboard integration
  //* is a separate, later piece of work — these stay null until it sends
  //* one). Deliberately not required to submit yet — enforcing it before
  //* the client actually sends it would just break submission entirely.
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  //* Reviewer ownership — plain ids, not Prisma relations to AdminUser,
  //* matching this schema's existing convention for admin-actor
  //* references (see createdByAdminId on Country/City/VendorType/...).
  //* assignedReviewerId = current owner (null = unclaimed). Persists
  //* through NEEDS_REVISION -> vendor resubmit -> back to review —
  //* never cleared except by explicit reassignment.
  //* reviewedById = who performed the latest substantive review action
  //* (may differ from assignedReviewerId after a reassignment).
  assignedReviewerId String?
  assignedAt         DateTime?
  reviewedById       String?

  //* Escalation — a permanent, non-clearing marker (unlike assignedReviewerId,
  //* which reassignment happily overwrites). escalatedByAdminId is the one
  //* fact that must survive every future claim/reassign: the escalating
  //* admin is locked out of acting on this application again, forever, by
  //* assertReviewerOwnership. A null assignedReviewerId alongside a set
  //* escalatedByAdminId means "open pool" — only admins holding
  //* vendors:applications:receive_escalation may claim it from there,
  //* instead of the normal "anyone with review" rule for unclaimed apps.
  escalatedByAdminId String?
  escalatedAt        DateTime?
  escalationReason   String?

  vendorAccount VendorAccount?   @relation("ApplicationToAccount")
  country       Country          @relation(fields: [countryId], references: [id])
  user          VendorUser?      @relation(fields: [userId], references: [id])
  vendorType    VendorType       @relation(fields: [vendorTypeId], references: [id])
  documents     VendorDocument[]
  appeals       VendorAppeal[]

  @@index([status])
  @@index([countryId])
  @@index([assignedReviewerId, status])
}

//* Roadmap VM-P1-04 (CLAUDE.md) — admin-side log/track/resolve of a
//* formal appeal against an adverse vendor decision (a rejected
//* application, an account suspension, or a ban). Vendor self-service
//* submission is deferred to the vendor-dashboard phase — every row here
//* is logged by an admin who received the appeal through another channel
//* (email, support ticket, etc.), same "record what happened" spirit as
//* VendorComplianceCase, but deliberately simpler: no claim-race lockout,
//* no escalation pool — appeal volume doesn't justify that machinery, and
//* the roadmap explicitly calls for the simplest workable model.
//*
//* Exactly one of applicationId/vendorId is set, matching subjectType —
//* same "one row, two possible anchors" convention as VendorDocument,
//* needed because a rejected VendorApplication never becomes a
//* VendorAccount, so there's no single FK that covers all three subject
//* types.
//*
//* Deliberately does NOT auto-reverse the underlying decision when
//* resolved OVERTURNED — reinstating a suspended account or unbanning a
//* vendor stays a separate, deliberate action via the existing
//* reinstateVendor/unbanVendor flows (same "human decision via the
//* existing action" pattern as compliance issues never auto-suspending).
//* Overturning a rejected APPLICATION currently has no reversal action
//* at all yet (no reopen-a-rejected-application transition exists in
//* admin.vendor.service.ts) — a known, documented gap, not silently
//* built around here.
model VendorAppeal {
  id            String            @id @default(uuid())
  applicationId String?
  vendorId      String?
  subjectType   AppealSubjectType
  reason        String
  status        AppealStatus      @default(OPEN)

  assignedReviewerId String?
  assignedAt         DateTime?

  //* Claim/escalate workflow (2026-08-28 rework) — modeled directly on
  //* VendorComplianceCase's own fields (see that model's comments for the
  //* full reasoning): escalatedByAdminId is a permanent, non-clearing
  //* marker (locks the escalator out of claiming this appeal again);
  //* claimedFromEscalation is true only while the CURRENT assignment was
  //* obtained by self-service claiming out of the open escalation pool
  //* (that admin is the terminal resolver — a reassignment resets this).
  //* Superseded the original "just READ/MANAGE, no claim/escalate" design
  //* — appeal volume was judged not to justify this machinery at the time
  //* VM-P1-04 shipped, but the user directed this be brought to parity
  //* with applications/compliance, matching how enterprise dispute queues
  //* (e.g. Uber Eats/DoorDash merchant-appeal review) route contested
  //* decisions through a claim → (optional escalate) → resolve pipeline
  //* rather than a bare assign/resolve.
  escalatedByAdminId    String?
  escalatedAt           DateTime?
  escalationReason      String?
  claimedFromEscalation Boolean   @default(false)

  //* Set once the stale-unclaimed alert has fired for this appeal (see
  //* APPEAL_STALE_NOTIFY_HOURS, vendor-ops-notifications.job.ts) —
  //* prevents re-notifying every cron run.
  staleNotifiedAt DateTime?

  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolutionNote    String?

  //* Who logged this appeal — always an admin, since vendor self-service
  //* submission doesn't exist yet (see model comment above).
  createdByAdminId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application VendorApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vendor      VendorAccount?     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([vendorId])
  @@index([status])
  @@index([assignedReviewerId, status])
  @@index([escalatedByAdminId, status])
}

enum AppealSubjectType {
  APPLICATION_REJECTION
  ACCOUNT_SUSPENSION
  ACCOUNT_BAN
}

enum AppealStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  UPHELD
  OVERTURNED
}

//* One document model, several possible anchors — the same "one row, two
//* possible anchors" convention VendorDocument already used for
//* application-time vs. account-time documents, extended with a third for
//* payout-account proof. Exactly one anchor is set per row:
//*   applicationId  — uploaded while applying (moves to vendorId on approval)
//*   vendorId       — an account-level vendor document
//*   payoutAccountId— proof of ownership for ONE bank payout account
//*                    (DocumentScope.PAYOUT_ACCOUNT, MANUAL-mode countries)
model VendorDocument {
  id              String         @id @default(uuid())
  applicationId   String?
  vendorId        String?
  payoutAccountId String?
  documentTypeId  String
  documentNumber  String?
  storageKey      String
  documentName    String?
  fileSize        Int?
  mimeType        String?
  issueDate       DateTime?
  expiryDate      DateTime?
  status          DocumentStatus @default(PENDING)
  uploadedAt      DateTime       @default(now())
  reviewedAt      DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  revisionNotes   String?
  supersededBy    String?
  supersededAt    DateTime?
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  application       VendorApplication?          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType      DocumentTypeConfig          @relation(fields: [documentTypeId], references: [id])
  vendor            VendorAccount?              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payoutAccount     VendorPayoutAccount?        @relation(fields: [payoutAccountId], references: [id], onDelete: Cascade)
  inheritedByStores OutletDocumentInheritance[]

  @@index([applicationId])
  @@index([vendorId])
  @@index([payoutAccountId])
  @@index([documentTypeId])
  @@index([status])
  @@index([expiryDate])
}

model VendorPayoutAccount {
  id                     String    @id @default(uuid())
  vendorId               String
  countryPaymentMethodId String // points to CountryPaymentMethod (OUTBOUND direction)
  isDefault              Boolean   @default(false)
  isActive               Boolean   @default(true)
  //* Admin deactivation trail. Distinct from a rejected verification: this is
  //* an account that WAS verified and has since been taken out of service, so
  //* it must not be recorded as a verification failure.
  deactivatedAt          DateTime?
  deactivationReason     String?
  deactivatedById        String?

  // Account details — kept flat for query performance.
  // The sensitive banking identifiers (bankCode, accountNumber, swiftCode,
  // iban, routingNumber, mobileNumber) are stored as AES-256-GCM ciphertext
  // at rest — see apps/backend/src/lib/crypto/field-encryption.ts. The
  // service layer decrypts on read for internal use and never returns the
  // plaintext to any client (maskedDetails is what clients get).
  accountHolderName String?
  bankName          String?
  branchName        String?
  bankCode          String? // encrypted
  // Provider bank BRANCH code — required by some provider/country/bank
  // combinations (e.g. Ghana) for bank transfers, not by others (e.g.
  // Kenya). Nullable and encrypted, alongside bankCode. The data model is
  // branch-aware; branch DISCOVERY (listing a bank's branches) is deferred
  // to the payout-execution phase — see provider.types.ts / CLAUDE.md.
  branchCode        String? // encrypted
  accountNumber     String? // encrypted
  swiftCode         String? // encrypted
  iban              String? // encrypted
  routingNumber     String? // encrypted
  mobileNetwork     String?
  mobileNumber      String? // encrypted
  paypalEmail       String?
  stripeAccountId   String?

  // Blind indexes (HMAC-SHA256, keyed) for cross-vendor duplicate detection
  // without decrypting — a deterministic hash of the normalised value.
  accountNumberHash String?
  mobileNumberHash  String?
  // Masked forms safe to return to any authorized viewer: { accountNumber: "••••1234", ... }
  maskedDetails     Json?
  // 0..1 similarity of accountHolderName vs the vendor's legal / owner name; null = not computed.
  nameMatchScore    Float?
  // Advisory risk signals set at creation / review — e.g. ["NAME_MISMATCH","ADD_VELOCITY","DUPLICATE_IDENTIFIER"].
  riskFlags         String[]

  // Verification
  verificationStatus PayoutVerificationStatus @default(PENDING)
  verificationMethod String? // "FINANCE_BANK_RESOLUTION" | "MANUAL" | "FORMAT_CHECKS"
  verificationRef    String? // external reference from verification API
  verificationMeta   Json? // safe derived detail (never raw identifiers), for audit
  verifiedAt         DateTime?
  verifiedBy         String? // adminUserId if MANUAL
  //* Who performed the latest review action (approve OR reject) and when —
  //* same convention as VendorApplication.reviewedById/reviewedAt. Distinct
  //* from verifiedBy/verifiedAt, which record the moment the account BECAME
  //* verified: a rejection previously left no reviewer on the row at all, so
  //* "who turned this down?" was only answerable from the audit log.
  //* Plain ids, not Prisma relations to AdminUser — same as every other
  //* reviewer field in this schema.
  reviewedById       String?
  reviewedAt         DateTime?

  //* Review workflow — identical shape to VendorAppeal / VendorComplianceCase.
  //* A payout decision moves real money, so it gets the same claim ->
  //* escalate -> reassign ordering the application review has, rather than
  //* letting two admins act on one account at once.
  //*
  //* There is deliberately NO separate review-status enum: the workflow
  //* state is derived from these columns plus verificationStatus (see
  //* payoutReviewState) — adding one would give "is this resolved?" two
  //* sources of truth, since verificationStatus already answers it.
  //*
  //* assignedReviewerId    = current owner (null = unclaimed / in the pool)
  //* escalatedByAdminId    = permanent historical marker; also that admin's
  //*                         own lockout from acting on this account again
  //* claimedFromEscalation = true only while the CURRENT assignment came
  //*                         from self-claiming out of the open pool — that
  //*                         admin is the end of the line and cannot escalate
  //*                         again. A reassignment resets it to false.
  assignedReviewerId      String?
  assignedAt              DateTime?
  escalatedByAdminId      String?
  escalatedAt             DateTime?
  escalationReason        String?
  claimedFromEscalation   Boolean   @default(false)
  failureReason           String? // human-readable, safe (never account data)
  // Safe internal code for the ERP review surface — see
  // PayoutVerificationFailureCode (lib/payout-verification/types.ts). Null
  // when VERIFIED, or a plain PENDING that just needs a look.
  verificationFailureCode String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendor               VendorAccount        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  countryPaymentMethod CountryPaymentMethod @relation(fields: [countryPaymentMethodId], references: [id])
  //* Proof-of-ownership documents for THIS account (MANUAL-mode countries).
  //* A list because a rejected+resubmitted account supersedes its previous
  //* proof rather than overwriting it — same versioning convention as every
  //* other VendorDocument.
  proofDocuments       VendorDocument[]

  @@index([vendorId])
  @@index([countryPaymentMethodId])
  @@index([isActive])
  @@index([verificationStatus])
  @@index([assignedReviewerId])
  @@index([accountNumberHash])
  @@index([mobileNumberHash])
}

//* ===================OUTLETS===================

model Outlet {
  id                 String                @id @default(uuid())
  vendorId           String
  cityId             String
  //* Operational zone this outlet resolves to (point-in-polygon of lat/lng
  //* against the city's zones, recomputed when zone geometry changes).
  //* Nullable: inside the city boundary but in no zone = REGISTRATION_ONLY
  //* floor; the populate/recompute wiring is a later stage.
  zoneId             String?
  name               String
  slug               String?               @unique
  avatar             String?
  bio                String?
  coverBanner        String?
  images             String[]
  addressLine1       String
  addressLine2       String?
  postalCode         String?
  neighborhood       String?
  latitude           Float
  longitude          Float
  //* Kilometres. A genuine measurement, so a float is right here — unlike the
  //* two money columns below, which are not.
  deliveryRadius     Float?
  deliveryZones      Json?
  //* MINOR UNITS, always, and named so the unit cannot be mistaken. These were
  //* Float, which is wrong for money for exactly the reason MenuItem's price
  //* was changed: it cannot hold 0.10 exactly, and every payment provider takes
  //* an integer anyway. The scale comes from the outlet's country currency
  //* (Currency.minorUnitDigits) and is never assumed to be 2.
  //*
  //* Nullable, and null means "not set" rather than zero — a free delivery of 0
  //* and an unset fee are different statements, and the difference matters the
  //* moment a checkout has to decide whether to charge anything.
  deliveryFeeMinor   Int?
  minimumOrderMinor  Int?
  phone              String?
  email              String?
  reviewStatus       OutletReviewStatus    @default(AUTO_APPROVED)
  //* Go-live gate — see OutletClearanceStatus. Computed at creation from the
  //* outlet's required CRITICAL documents (a later stage wires that); until
  //* then every outlet is CLEARED, preserving today's "live immediately"
  //* behaviour for existing rows.
  clearanceStatus    OutletClearanceStatus @default(CLEARED)
  clearanceUpdatedAt DateTime?
  isMainOutlet       Boolean               @default(false)
  ratings            Float                 @default(0)
  totalReviews       Int                   @default(0)
  isFeatured         Boolean               @default(false)
  adminStatus        OutletAdminStatus     @default(ACTIVE)
  flagReasons        String[] // populated by the flagging checks on creation
  flaggedAt          DateTime?
  reviewedAt         DateTime?

  isTemporarilyClosed    Boolean   @default(false)
  temporarilyClosedUntil DateTime?

  adminReviewedBy       String?
  //* Set on MANUALLY_REJECTED — mirrors VendorProfile.rejectionReason.
  //* Cleared on the next vendor edit that recomputes flags (same
  //* "a fresh edit supersedes a prior rejection" convention).
  rejectionReason       String?
  adminSuspendedAt      DateTime?
  adminSuspendUntil     DateTime?
  adminSuspensionReason String?
  adminBannedAt         DateTime?
  adminBanReason        String?
  vendorDisabledAt      DateTime?
  deletedAt             DateTime?
  vendorUpdatedAt       DateTime?
  createdAt             DateTime  @default(now())

  vendor                   VendorAccount               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  zone                     Zone?                       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  meals                    Meal[]
  mealPlans                MealPlan[]
  discounts                DiscountOutlet[]
  documents                OutletDocument[]
  inspections              OutletInspection[]
  operatingHours           OutletOperatingHours[]
  inheritedVendorDocuments OutletDocumentInheritance[]

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([cityId])
  @@index([zoneId])
  @@index([slug])
  @@index([adminStatus])
  @@index([clearanceStatus])
  @@index([latitude, longitude])
}

model OutletOperatingHours {
  id         String    @id @default(uuid())
  outletId   String
  dayOfWeek  DayOfWeek
  openTime   String
  closeTime  String
  isClosed   Boolean   @default(false)
  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, dayOfWeek, validFrom])
  @@index([outletId])
}

model OutletDocument {
  id                        String         @id @default(uuid())
  outletId                  String
  documentTypeId            String
  documentNumber            String?
  storageKey                String
  documentName              String?
  fileSize                  Int?
  mimeType                  String?
  issueDate                 DateTime?
  expiryDate                DateTime?
  status                    DocumentStatus @default(PENDING)
  submittedAt               DateTime       @default(now())
  reviewedAt                DateTime?
  approvedAt                DateTime?
  rejectedAt                DateTime?
  rejectionReason           String?
  revisionNotes             String?
  supersededBy              String?
  supersededAt              DateTime?
  version                   Int            @default(1)
  //* Escalating expiry-reminder dedup — the day-threshold (60/30/14/7/3/1/0)
  //* of the most recent reminder sent to the vendor for THIS document row.
  //* Null = no reminder yet. Reset naturally: a replacement is a new row.
  lastExpiryReminderDaysOut Int?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  documentType DocumentTypeConfig @relation(fields: [documentTypeId], references: [id])
  outlet       Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, documentTypeId, supersededAt])
  @@index([outletId])
  @@index([documentTypeId])
  @@index([status])
  @@index([expiryDate])
}

//* A physical premises inspection of an outlet. Required (per
//* Country.outletInspectionPolicy) before an outlet can offer meal plans —
//* the meal-plan-eligibility gate, deliberately NOT an on-demand gate (see
//* getOutletMealPlanReadiness). Deliberately simpler than the compliance-case
//* machinery: no claim/escalate/reassign — an admin schedules a visit,
//* conducts it, records PASS/FAIL with a checklist + photos, or waives the
//* requirement. A PASSED inspection may carry validUntil for a re-inspection
//* cadence, same idea as a document's expiryDate.
model OutletInspection {
  id                 String                 @id @default(uuid())
  outletId           String
  status             OutletInspectionStatus @default(SCHEDULED)
  scheduledFor       DateTime?
  scheduledByAdminId String?
  inspectorAdminId   String?
  startedAt          DateTime?
  completedAt        DateTime?
  validUntil         DateTime?
  checklist          Json? // structured form responses — shape owned by the frontend, stored opaquely
  findings           String?
  failureReasons     String[] // populated on FAILED, surfaced to the vendor
  waiveReason        String? // populated on WAIVED
  photos             String[] // R2 storage keys captured during the visit
  notes              String? // scheduling / cancellation context
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([status])
  @@index([scheduledFor])
}

model OutletDocumentInheritance {
  id               String   @id @default(uuid())
  outletId         String
  vendorDocumentId String
  documentTypeId   String
  inheritedAt      DateTime @default(now())
  isActive         Boolean  @default(true)

  documentType   DocumentTypeConfig @relation(fields: [documentTypeId], references: [id])
  outlet         Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  vendorDocument VendorDocument     @relation(fields: [vendorDocumentId], references: [id], onDelete: Cascade)

  @@unique([outletId, documentTypeId])
  @@index([outletId])
  @@index([vendorDocumentId])
  @@index([documentTypeId])
}

//* ==================MEALS & MENU =============================

//* =========FOOD TAXONOMY=============
//
// Two admin-managed catalogs a vendor picks from: what kind of food they serve
// (Cuisine) and which diets they cater for (DietaryTag). Both follow the
// VendorType / VendorTypeCountry shape exactly:
//
//   global catalog  — created and edited only at GLOBAL scope
//   <X>Country      — which entries a given country has switched on
//
// The point is analysis: a controlled vocabulary can be aggregated across
// vendors and filtered on by customers; free text cannot. This replaced
// VendorProfile.specialties / .dietaryOptions, which were exactly that free
// text. Uber Eats, DoorDash and Bolt Food all use a controlled cuisine
// taxonomy on a store for the same reason.

model Cuisine {
  id               String         @id @default(uuid())
  code             String         @unique
  //* URL identity for the admin detail page, same convention as
  //* VendorType.slug — regenerated on rename via ensureUniqueSlug.
  slug             String         @unique
  name             String
  description      String?
  status           TaxonomyStatus @default(ACTIVE)
  createdByAdminId String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  menuItems      MenuItemCuisine[]
  //* Kept from the original model and still unused: a single "primary"
  //* category is a real Uber Eats concept, but the vendor form only sets the
  //* multi-select (vendorProfiles) today. Adopt or drop deliberately.
  primaryVendors VendorProfile[]
  countries      CuisineCountry[]
  vendorProfiles VendorProfileCuisine[]

  @@index([status])
  @@index([deletedAt])
}

//* Which cuisines a country has switched on. Mirrors VendorTypeCountry —
//* including using GeoStatus and soft-disabling rather than deleting, so
//* re-enabling later restores the same row instead of orphaning history.
model CuisineCountry {
  id               String    @id @default(uuid())
  countryId        String
  cuisineId        String
  status           GeoStatus @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime  @default(now())

  country Country @relation(fields: [countryId], references: [id])
  cuisine Cuisine @relation(fields: [cuisineId], references: [id])

  @@unique([countryId, cuisineId])
  @@index([countryId])
  @@index([cuisineId])
  @@index([status])
}

model DietaryTag {
  id               String         @id @default(uuid())
  code             String         @unique
  slug             String         @unique
  name             String
  description      String?
  status           TaxonomyStatus @default(ACTIVE)
  createdByAdminId String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  countries      DietaryTagCountry[]
  vendorProfiles VendorProfileDietaryTag[]
  menuItems      MenuItemDietaryTag[]

  @@index([status])
  @@index([deletedAt])
}

model DietaryTagCountry {
  id               String    @id @default(uuid())
  countryId        String
  dietaryTagId     String
  status           GeoStatus @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime  @default(now())

  country    Country    @relation(fields: [countryId], references: [id])
  dietaryTag DietaryTag @relation(fields: [dietaryTagId], references: [id])

  @@unique([countryId, dietaryTagId])
  @@index([countryId])
  @@index([dietaryTagId])
  @@index([status])
}

//* A vendor's selections. Restrict on delete rather than cascade: a catalog
//* entry vendors are actively using must be suspended, never silently removed
//* from their profiles.
model VendorProfileCuisine {
  vendorProfileId String
  cuisineId       String

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  cuisine       Cuisine       @relation(fields: [cuisineId], references: [id], onDelete: Restrict)

  @@id([vendorProfileId, cuisineId])
  @@index([cuisineId])
}

model VendorProfileDietaryTag {
  vendorProfileId String
  dietaryTagId    String

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  dietaryTag    DietaryTag    @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)

  @@id([vendorProfileId, dietaryTagId])
  @@index([dietaryTagId])
}

//* ─── MENU ──────────────────────────────────────────────────────────────────
//*
//* A dish is authored ONCE by the vendor (MenuItem) and sold at one or more of
//* their outlets (Meal). This is the shape every multi-location food platform
//* converges on — Deliveroo assigns a menu to many sites with per-site price
//* overrides, and Toast/Square/Olo hold a master item catalog with per-location
//* overrides — because the three things that genuinely differ by location are
//* price, availability and being temporarily out of stock, and nothing else is.
//*
//* Duplicating the whole dish per outlet was the alternative. It was rejected
//* because it makes an intentional price difference indistinguishable from
//* drift, multiplies every future variant and addon by the outlet count, and
//* leaves "how is this dish doing across the business" unanswerable — there
//* would be no single row that IS the dish.

//* A vendor's own menu grouping (Starters, Mains, Drinks). Vendor-owned rather
//* than outlet-owned so one business presents one menu structure everywhere;
//* which ITEMS appear at an outlet is the Meal rows' job, not the section's.
//* A heading on the vendor's menu: Starters, Mains, Drinks.
//*
//* Vendor-scoped, not outlet-scoped, deliberately: one business presents one
//* menu structure everywhere, and WHICH dishes appear at a given outlet is the
//* Meal rows' job. Deleting a section never deletes its dishes — they fall back
//* to unsectioned, which is why MenuItem.sectionId is nullable and SetNull.
model MenuSection {
  id        String         @id @default(uuid())
  vendorId  String
  name      String
  //* Menus are ordered by intent (starters before desserts), never
  //* alphabetically, so position is authored and not derived.
  position  Int            @default(0)
  status    TaxonomyStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  vendor VendorAccount @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([deletedAt])
}

//* The dish itself — the vendor's catalog entry, and the thing a variant, an
//* addon or a discount will eventually hang off.
model MenuItem {
  id             String   @id @default(uuid())
  vendorId       String
  sectionId      String?
  name           String
  description    String?
  //* MINOR UNITS, always. Float was the previous representation and is wrong
  //* for money: it cannot hold 0.10 exactly, and every payment provider takes
  //* an integer anyway. The scale comes from the vendor's country currency
  //* (Currency.minorUnitDigits), which is never assumed to be 2.
  basePriceMinor Int
  //* Which tax rate this dish attracts in its country. NULL is the common
  //* case and is a real answer, not a missing one: it means "whatever this
  //* country taxes prepared food at", resolved via the country's standard
  //* CountryTaxRate. A vendor in a flat-rate market never sees this field.
  taxCategoryId  String?
  //* R2 storage KEYS, not URLs — the bucket is private, so reads go out as
  //* short-lived signed URLs. Named ...Key for the same reason the profile's
  //* media columns were renamed: a key in a column called ...Url invites an
  //* <img src> and a 403.
  mainImageKey   String?
  //* The gallery. Food photography, so none of the premises-disclosure
  //* reasoning that removed the profile gallery applies here.
  imageKeys      String[]
  portionSize    String?

  //* Where this dish sits INSIDE its section. Authored, never alphabetical —
  //* a menu is ordered by intent, which is the same reason MenuSection.position
  //* exists. A dish with no section is ordered against the other unsectioned
  //* ones. New dishes go to the end of their section rather than the top: a
  //* vendor adding their fortieth dish did not ask for it to lead the menu.
  position Int @default(0)

  //* Minutes from order accepted to ready for collection. Uber Eats and
  //* DoorDash both carry this per item, because a courier arrival time is only
  //* as good as the slowest dish on the ticket. Nullable — a vendor who has not
  //* said is different from one who said zero, and nothing consumes it yet
  //* (there is no order), so an invented default would be a lie with a number
  //* attached.
  prepTimeMinutes Int?
  //* The vendor's own switch: a dish they have stopped selling everywhere
  //* without deleting it (deleting is impossible once it is in a meal plan).
  isArchived      Boolean @default(false)

  //* Content moderation, mirroring Outlet/VendorProfile exactly.
  reviewStatus      ProfileReviewStatus @default(AUTO_APPROVED)
  flagReasons       String[]
  flaggedAt         DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  rejectionReason   String?

  //* Platform-side lifecycle, independent of the vendor's own archive flag —
  //* same capability/health/moderation axis separation as Outlet.
  adminStatus      MealStatus @default(ACTIVE)
  adminSuspendedAt DateTime?
  adminBannedAt    DateTime?

  deletedAt       DateTime?
  vendorUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor         VendorAccount           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  section        MenuSection?            @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  //* Restrict, like cuisines: a category vendors have applied must be
  //* suspended rather than vanish and silently reprice their menu.
  taxCategory    TaxCategory?            @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  cuisines       MenuItemCuisine[]
  dietaryTags    MenuItemDietaryTag[]
  outletMeals    Meal[]
  modifierGroups MenuItemModifierGroup[]
  discounts      DiscountMenuItem[]

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([sectionId])
  @@index([sectionId, position])
  @@index([taxCategoryId])
  @@index([reviewStatus])
  @@index([adminStatus])
  @@index([deletedAt])
  @@index([createdAt])
}

model MenuItemCuisine {
  menuItemId String
  cuisineId  String

  cuisine  Cuisine  @relation(fields: [cuisineId], references: [id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([menuItemId, cuisineId])
  @@index([cuisineId])
}

model MenuItemDietaryTag {
  menuItemId   String
  dietaryTagId String

  dietaryTag DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([menuItemId, dietaryTagId])
  @@index([dietaryTagId])
}

//* One dish, sold at one outlet. Carries ONLY what genuinely varies by
//* location; everything descriptive lives on the MenuItem, so editing a photo
//* or a description is one write however many outlets sell it.
model Meal {
  id         String @id @default(uuid())
  outletId   String
  menuItemId String

  //* Null means "use the catalog price". An explicit value is a deliberate
  //* local price, which is exactly the distinction duplicated rows lose.
  priceMinorOverride Int?
  //* 86-ing: off today, back tomorrow. Distinct from MenuItem.isArchived
  //* (withdrawn everywhere) and from adminStatus (a platform action).
  isAvailable        Boolean @default(true)

  adminStatus      MealStatus @default(ACTIVE)
  adminSuspendedAt DateTime?
  adminBannedAt    DateTime?
  deletedAt        DateTime?
  vendorUpdatedAt  DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  outlet    Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItem  MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  mealPlans MealPlanMeal[]

  @@unique([outletId, menuItemId])
  @@index([outletId])
  @@index([menuItemId])
  @@index([adminStatus])
  @@index([deletedAt])
  @@index([createdAt])
}

//* ─── MODIFIERS ─────────────────────────────────────────────────────────────
//*
//* What a customer chooses ON a dish: size, flavour, a drink, sauces, extras.
//*
//* ONE primitive, not two. "Variants" and "addons" are the same thing with
//* different selection rules, and every serious platform models them that way —
//* Uber Eats calls them customizations, DoorDash option lists, Toast and Square
//* modifier groups. A size group is "pick exactly one", a sauce group is "pick
//* up to three", and that is the entire difference. Modelling them as separate
//* tables would mean two pricing paths, two forms and two order-line shapes,
//* and every future rule (a discount, a tax category) written twice.
//*
//* Groups are VENDOR-scoped and reusable: one "Sauces" group attached to
//* twelve dishes, edited once. That reuse is the whole reason a vendor with a
//* real menu can maintain this at all, and it is what Deliveroo, Toast, Square
//* and Olo all do.
//*
//* Deliberately NOT here, and each is a real decision rather than an oversight:
//*   - NESTED modifiers (an option opening its own group, DoorDash's
//*     half-and-half pizza). Roughly doubles cart-resolution complexity.
//*   - PER-OUTLET option pricing. Only price and availability vary by location
//*     on a Meal, and letting the option SET differ per outlet would mean the
//*     dish is no longer one dish.
model ModifierGroup {
  id          String  @id @default(uuid())
  vendorId    String
  name        String
  //* Shown under the group heading when the choice needs explaining
  //* ("Pick a side — the first one is included").
  description String?

  //* The selection rule, and the ONLY thing separating a variant from an
  //* addon. `required` is deliberately NOT a column: it is exactly
  //* minSelect >= 1, and storing it as well would give one question two
  //* answers that can disagree.
  minSelect Int @default(0)
  maxSelect Int @default(1)

  //* Content moderation, mirroring MenuItem/Outlet/VendorProfile. Option names
  //* are screened into this too — they are customer-visible vendor free text
  //* exactly as the group name is. A flag here also re-flags every attached
  //* MenuItem, so a flagged modifier lands in the existing meal review queue
  //* rather than needing a queue of its own.
  reviewStatus      ProfileReviewStatus @default(AUTO_APPROVED)
  flagReasons       String[]
  flaggedAt         DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  rejectionReason   String?

  deletedAt       DateTime?
  vendorUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor    VendorAccount           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  options   ModifierOption[]
  menuItems MenuItemModifierGroup[]

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([reviewStatus])
  @@index([deletedAt])
}

//* One choice inside a group.
model ModifierOption {
  id      String @id @default(uuid())
  groupId String
  name    String

  //* A DELTA on the dish price, in minor units, never an absolute price.
  //* Small is +0 and Large is +200, so one dish has one price and the options
  //* move it. May be negative (a smaller portion that costs less) and is
  //* routinely zero, which is why there is no "above zero" rule here unlike
  //* MenuItem.basePriceMinor.
  priceDeltaMinor Int @default(0)

  //* 86-ing at option granularity: out of tomatoes takes "extra tomato" off
  //* without taking the burger down. Vendor-level for now — per-outlet option
  //* availability is the same deferred decision as per-outlet option pricing.
  isAvailable Boolean @default(true)

  //* Authored order, never alphabetical: Small/Medium/Large is the point.
  position Int @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
  @@index([groupId])
  @@index([deletedAt])
}

//* Which dishes use which group. Carries the per-dish ORDER only: the
//* selection rule belongs to the group, so the same group behaves identically
//* everywhere it appears. A vendor wanting different rules makes a second
//* group, which keeps "what does this group do" a question with one answer.
model MenuItemModifierGroup {
  menuItemId String
  groupId    String
  position   Int    @default(0)

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, groupId])
  @@index([groupId])
}

//* ─── DISCOUNTS ─────────────────────────────────────────────────────────────
//*
//* A discount is NEVER a mutation of a price. The menu price stays exactly as
//* the vendor set it and the discount applies at cart time, recording itself as
//* its own line. That is what lets gross sales, discounts and net be reported
//* separately, lets an offer expire without a data migration, and lets anyone
//* answer what a campaign actually cost. Uber Eats, DoorDash and Bolt Food all
//* work this way.
//*
//* Composition order, fixed in lib/pricing and not negotiable per-feature:
//*     base + selected option deltas = line subtotal
//*   - discount                      = taxable amount
//*   ± tax                           = what the customer pays
//* Commission is then charged on the DISCOUNTED amount (explicit product
//* decision, following Uber Eats): the platform takes no cut of a discount the
//* vendor funded.
//*
//* STATUS IS DERIVED, NOT STORED. Scheduled / running / expired / exhausted all
//* follow from the window, the caps and the clock, so only genuine state gets a
//* column here: a vendor's pause and an admin's suspension. This is the same
//* choice payoutReviewState and VendorLifecycleState make, and it means no cron
//* flipping rows and no second answer to "is this offer running".
//*
//* A vendor may create and SCHEDULE a discount before their storefront is live
//* — building a launch promotion during onboarding is normal — and it simply
//* never reaches the running state until they publish. That needs no extra
//* column; it falls out of the derived state.
model Discount {
  id          String  @id @default(uuid())
  vendorId    String
  //* The vendor's own label for it. Not customer-facing copy.
  name        String
  description String?

  type          DiscountType
  //* Who pays. Only VENDOR is writable today; the column exists from the start
  //* because retrofitting attribution after real money has moved is the
  //* expensive version of this.
  fundingSource DiscountFunding @default(VENDOR)

  //* PERCENTAGE_OFF_ITEMS — basis points, 2000 is 20%. Same unit as
  //* CountryTaxRate.rateBps and VendorAccount.commissionRateBps.
  percentBps       Int?
  //* AMOUNT_OFF_ORDER — minor units off, and the subtotal a basket must reach
  //* before it applies at all.
  amountMinor      Int?
  minSubtotalMinor Int?

  //* Targeting is EXPLICIT, never inferred from an empty list. A vendor who
  //* deselects every item means "I have not chosen yet", not "discount my whole
  //* menu" — the same reasoning that makes a partial reorder an error rather
  //* than a guess.
  appliesToAllOutlets Boolean @default(true)
  appliesToAllItems   Boolean @default(true)

  startsAt   DateTime
  endsAt     DateTime?
  //* Happy-hour windows. An EMPTY day list means no day restriction, which is
  //* different from the flags above: a day filter is an optional narrowing, and
  //* there is no such thing as an offer that runs on no days.
  daysOfWeek DayOfWeek[]
  //* "17:00" / "19:00", local to the outlet. Null means all day.
  startTime  String?
  endTime    String?

  //* Caps. RECORDED BUT NOT YET ENFORCED — there is no order to redeem
  //* against, so nothing increments these. Same "designed, not enforced"
  //* honesty as VendorAccount.payoutHoldStatus.
  budgetMinor     Int?
  spentMinor      Int  @default(0)
  maxRedemptions  Int?
  redemptionCount Int  @default(0)
  //* Needs a per-customer redemption record, which needs orders and a consumer.
  maxPerCustomer  Int?

  //* The vendor's own switch. Genuine state, so it is stored.
  isPaused Boolean @default(false)

  //* An admin stopping someone else's offer. Also genuine state, and kept
  //* apart from the vendor's pause so neither can silently undo the other.
  suspendedAt        DateTime?
  suspendedByAdminId String?
  suspensionReason   String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendor  VendorAccount      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  outlets DiscountOutlet[]
  items   DiscountMenuItem[]

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([deletedAt])
}

//* Which of the vendor's outlets an offer runs at. Only consulted when
//* appliesToAllOutlets is false.
model DiscountOutlet {
  discountId String
  outletId   String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([discountId, outletId])
  @@index([outletId])
}

//* Which dishes a percentage offer covers. Only consulted when
//* appliesToAllItems is false. Cascade rather than Restrict: unlike a cuisine,
//* a discount target carries no history worth preserving once the dish is gone.
model DiscountMenuItem {
  discountId String
  menuItemId String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([discountId, menuItemId])
  @@index([menuItemId])
}

model MealPlan {
  id                    String                 @id @default(uuid())
  outletId              String
  name                  String
  description           String?
  //* Minor units, same reasoning as MenuItem.basePriceMinor.
  priceMinor            Int?
  images                String[]
  isPublished           Boolean                @default(false)
  isFeatured            Boolean                @default(false)
  adminStatus           MealStatus             @default(ACTIVE)
  adminSuspendedAt      DateTime?
  adminBannedAt         DateTime?
  deletedAt             DateTime?
  subscriptionWindowEnd DateTime? // no new subs after this timestamp
  startsAt              DateTime? // first delivery day
  endsAt                DateTime? // last delivery day
  batchZones            MealPlanBatchZone[]
  subscriptions         MealPlanSubscription[]
  vendorUpdatedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  outlet Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  meals  MealPlanMeal[]

  @@unique([outletId, name])
  @@index([outletId])
  @@index([adminStatus])
  @@index([deletedAt])
  @@index([createdAt])
}

model MealPlanMeal {
  mealPlanId String
  mealId     String

  meal     Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@id([mealPlanId, mealId])
  @@index([mealId])
}

// One record per subscriber per meal plan.
// Delivery address (lat/lng) is locked at subscription time — never changes.
// This is the source of truth for batch zone computation.
// batchZoneId is populated after the system computes zones post-window-close.
model MealPlanSubscription {
  id           String                     @id @default(uuid())
  mealPlanId   String
  consumerId   String
  batchZoneId  String?
  addressLine1 String
  addressLine2 String?
  latitude     Float
  longitude    Float
  status       MealPlanSubscriptionStatus @default(ACTIVE)
  subscribedAt DateTime                   @default(now())
  cancelledAt  DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, consumerId])
  @@index([mealPlanId])
  @@index([consumerId])
  @@index([batchZoneId])
  @@index([status])
}

//* ==================CUSTOMERS====================

model ConsumerAccount {
  id               String         @id @default(uuid())
  clerkId          String         @unique
  email            String         @unique
  fullName         String?
  phone            String?
  countryId        String?
  status           ConsumerStatus @default(ACTIVE)
  suspendedAt      DateTime?
  suspensionReason String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  addresses ConsumerAddress[]

  @@index([clerkId])
  @@index([email])
  @@index([status])
}

model ConsumerAddress {
  id                String   @id @default(uuid())
  consumerAccountId String
  label             String?
  addressLine1      String
  addressLine2      String?
  city              String
  postalCode        String?
  countryId         String
  latitude          Float?
  longitude         Float?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  consumer ConsumerAccount @relation(fields: [consumerAccountId], references: [id], onDelete: Cascade)

  @@index([consumerAccountId])
  @@index([consumerAccountId, isDefault])
}

