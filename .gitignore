.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

packages/database/generated
# Compiler emit must never land next to sources. packages/ui once built with
# `tsc -b` and no outDir, which littered src/ with .js/.d.ts/.d.ts.map — and a
# sweep of those strays is what deleted the shared component library in 30facf5.
*.tsbuildinfo
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
